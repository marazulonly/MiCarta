{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "A restaurant venue in the Micarta platform",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "tagline": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["id", "name", "slug"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "A dish or drink item in a restaurant menu",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "isAvailable": { "type": "boolean" },
        "prepTimeMinutes": { "type": "number" }
      },
      "required": ["id", "restaurantId", "categoryId", "name", "price"]
    },
    "MenuCategory": {
      "title": "MenuCategory",
      "description": "Category for organizing menu items",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "name": { "type": "string" },
        "sortOrder": { "type": "number" }
      },
      "required": ["id", "restaurantId", "name"]
    },
    "User": {
      "title": "User",
      "description": "Staff member or admin profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "dni": { "type": "string" }
      },
      "required": ["id", "name", "role", "dni"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer dining or delivery order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "restaurantId": { "type": "string" },
        "orderNumber": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" }
      },
      "required": ["id", "restaurantId", "orderNumber", "status", "total"]
    }
  },
  "firestore": {
    "/restaurants/{restaurantId}": {
      "schema": "Restaurant",
      "description": "Collection of registered restaurants"
    },
    "/items/{itemId}": {
      "schema": "MenuItem",
      "description": "Individual menu items and dishes"
    },
    "/menu_items/{itemId}": {
      "schema": "MenuItem",
      "description": "Individual menu items and dishes alias"
    },
    "/categories/{categoryId}": {
      "schema": "MenuCategory",
      "description": "Menu categories per restaurant"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and permissions"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Orders created by diners or waiters"
    },
    "/system_snapshot/{snapshotId}": {
      "schema": "object",
      "description": "Aggregated snapshot of all system data"
    }
  }
}
